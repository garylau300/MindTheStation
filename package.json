{
  "name": "mind-the-station",
  "private": true,
  "version": "1.0.0",
  "description": "London Underground station-memorization trainer (single-file app) plus its regression test suite.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:geometry": "node --test test/geometry.test.js",
    "test:gameplay": "node --test test/gameplay.test.js",
    "test:interchanges": "node --test test/interchanges.test.js",
    "test:security": "node --test test/security.test.js",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "jsdom": "^25.0.0"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
